---
/**
 * Language dropdown. Built on <details> so it works without JS; the script adds
 * listbox keyboard support (arrows, Home/End, Enter/Space, Esc) and outside-click close.
 */
import { LANG_NAMES, LOCALES, type Lang } from '../i18n/locales';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const label = t(lang).common.language;
---

<details class="lang" data-lang-switch>
  <summary aria-haspopup="listbox" aria-label={`${label}: ${LANG_NAMES[lang]}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true" class="globe"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"></path></svg>
    <span>{lang.toUpperCase()}</span><span class="hide-sm name">{LANG_NAMES[lang]}</span>
    <svg viewBox="0 0 24 24" aria-hidden="true" class="chev"><path d="M6 9l6 6 6-6"></path></svg>
  </summary>
  <ul role="listbox" aria-label={label} class="menu">
    {
      LOCALES.map((l) => (
        <li role="presentation">
          <a
            role="option"
            href={alternates[l]}
            hreflang={l}
            lang={l}
            aria-selected={l === lang ? 'true' : 'false'}
            aria-current={l === lang ? 'page' : undefined}
            class:list={{ on: l === lang }}
          >
            <span>{LANG_NAMES[l]}</span>
            <span class="code">
              {l === lang ? '● ' : ''}
              {l.toUpperCase()}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang {
    position: relative;
  }
  summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border: 1px solid var(--line);
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.12em;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .name {
    opacity: 0.65;
    letter-spacing: 0.04em;
  }
  .globe {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .chev {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    transition: transform 0.3s;
  }
  .lang[open] .chev {
    transform: rotate(180deg);
  }
  .menu {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    z-index: 30;
    margin: 0;
    padding: 6px;
    list-style: none;
    min-width: 230px;
    background: var(--white);
    border: 1px solid var(--line);
    box-shadow: 0 28px 56px rgba(20, 24, 28, 0.16);
    animation: menu 0.28s var(--ease) both;
  }
  @keyframes menu {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .menu a {
    width: 100%;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 14px;
    font: 500 15px var(--sans);
    color: var(--black);
  }
  .menu a:hover,
  .menu a:focus-visible {
    background: var(--paper-2);
    outline-offset: -2px;
  }
  .menu a.on {
    background: var(--ink);
    color: var(--on-ink);
  }
  .code {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    opacity: 0.7;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLDetailsElement>('[data-lang-switch]')) {
    const summary = root.querySelector('summary')!;
    const options = [...root.querySelectorAll<HTMLAnchorElement>('[role="option"]')];
    const sync = () => summary.setAttribute('aria-expanded', String(root.open));
    sync();
    const focusAt = (i: number) => options[(i + options.length) % options.length]?.focus();
    const current = () => Math.max(0, options.findIndex((o) => o.getAttribute('aria-selected') === 'true'));
    const close = (refocus = false) => {
      root.open = false;
      sync();
      if (refocus) summary.focus();
    };

    root.addEventListener('toggle', () => {
      sync();
      if (root.open) requestAnimationFrame(() => focusAt(current()));
    });
    summary.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        root.open = true;
        sync();
        requestAnimationFrame(() => focusAt(current()));
      }
    });
    root.addEventListener('keydown', (e) => {
      const i = options.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'Escape' && root.open) {
        e.preventDefault();
        close(true);
      } else if (i >= 0 && e.key === 'ArrowDown') {
        e.preventDefault();
        focusAt(i + 1);
      } else if (i >= 0 && e.key === 'ArrowUp') {
        e.preventDefault();
        focusAt(i - 1);
      } else if (i >= 0 && e.key === 'Home') {
        e.preventDefault();
        focusAt(0);
      } else if (i >= 0 && e.key === 'End') {
        e.preventDefault();
        focusAt(options.length - 1);
      } else if (i >= 0 && e.key === ' ') {
        e.preventDefault();
        options[i].click();
      } else if (e.key === 'Tab' && root.open) {
        close();
      }
    });
    document.addEventListener('click', (e) => {
      if (root.open && !root.contains(e.target as Node)) close();
    });
    // Keep the query string (e.g. ?ref=677 on the quote page) and the hash when switching language.
    for (const o of options) {
      o.addEventListener('click', () => {
        if (location.search || location.hash) o.href = o.pathname + location.search + location.hash;
      });
    }
  }
</script>
