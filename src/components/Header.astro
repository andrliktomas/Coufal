---
import { Image } from 'astro:assets';
import LangSwitch from './LangSwitch.astro';
import logo from '../assets/brand/logo-ink.png';
import { LANG_NAMES, LOCALES, type Lang } from '../i18n/locales';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';
import { heroFor } from '../lib/site';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
  home?: boolean;
}
const { lang, alternates, home = false } = Astro.props;
const nav = heroFor(lang).nav;
const homePath = pathFor({ type: 'home' }, lang);
const anchor = (id: string) => (home ? `#${id}` : `${homePath}#${id}`);
const u = t(lang);
const links = [
  { href: pathFor({ type: 'archive' }, lang), label: nav.archive },
  { href: anchor('index'), label: nav.products },
  { href: anchor('process'), label: nav.process },
  { href: anchor('studio'), label: nav.workshop },
];
const quoteHref = pathFor({ type: 'quote' }, lang);
---

<header class:list={['site-header wrap', { 'is-home': home }]}>
  <a href={homePath} class="logo" aria-label={`CRdesign — ${u.common.home}`}>
    <Image src={logo} alt="CRdesign" width={76} height={74} densities={[1, 2]} loading="eager" />
  </a>

  <!-- Desktop -->
  <nav aria-label={u.common.mainNav} class="nav caps desk">
    {links.map((l) => <a class="lnk" href={l.href}>{l.label}</a>)}
  </nav>
  <div class="tools desk">
    <LangSwitch lang={lang} alternates={alternates} />
    <a href={quoteHref} class:list={['btn', { 'btn--line': !home }]}>{nav.quote}</a>
  </div>

  <!-- Mobile: one menu button; <details> keeps it working without JS -->
  <details class="burger" data-burger>
    <summary aria-label={u.common.menu} data-label-open={u.common.menu} data-label-close={u.common.menuClose}>
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </summary>
    <div class="panel">
      <nav aria-label={u.common.mainNav} class="m-nav">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <a href={quoteHref} class="btn btn--lg m-quote">{nav.quote} →</a>
      <div class="m-langs" aria-label={u.common.language} role="group">
        <span class="label">{u.common.language}</span>
        <ul>
          {
            LOCALES.map((l) => (
              <li>
                <a href={alternates[l]} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined} data-keep-query>
                  {LANG_NAMES[l]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </details>
</header>

<style>
  .site-header {
    padding-top: 18px;
    padding-bottom: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 40;
  }
  .site-header:not(.is-home) {
    border-bottom: 1px solid var(--line);
  }
  .logo {
    display: flex;
    align-items: center;
  }
  .logo img {
    width: 76px;
    height: 74px;
    object-fit: contain;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 36px;
    align-items: center;
  }
  .nav a {
    padding: 12px 0;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
  }

  .burger {
    display: none;
  }
  .burger summary {
    list-style: none;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    cursor: pointer;
    position: relative;
    z-index: 2;
  }
  .burger summary::-webkit-details-marker {
    display: none;
  }
  .bars {
    width: 20px;
    height: 14px;
    position: relative;
  }
  .bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--ink);
    transition:
      transform 0.3s var(--ease),
      opacity 0.2s;
  }
  .bars span:nth-child(1) {
    top: 0;
  }
  .bars span:nth-child(2) {
    top: 6px;
  }
  .bars span:nth-child(3) {
    top: 12px;
  }
  .burger[open] .bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .burger[open] .bars span:nth-child(2) {
    opacity: 0;
  }
  .burger[open] .bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  .panel {
    position: fixed;
    inset: 0;
    z-index: 1;
    overflow-y: auto;
    background: var(--paper);
    padding: 96px var(--pad) 40px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    animation: panel 0.3s var(--ease) both;
  }
  @keyframes panel {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .m-nav {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--ink);
  }
  .m-nav a {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(36px, 10vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--black);
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .m-quote {
    align-self: flex-start;
  }
  .m-langs ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
  .m-langs a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-size: 16px;
  }
  .m-langs a[aria-current='page'] {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 860px) {
    .desk {
      display: none !important;
    }
    .burger {
      display: block;
    }
    .site-header {
      flex-wrap: nowrap;
    }
    .logo {
      position: relative;
      z-index: 2;
    }
    .logo img {
      width: 56px;
      height: 54px;
    }
  }
</style>

<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-burger]')) {
    const summary = menu.querySelector('summary')!;
    const sync = () => {
      summary.setAttribute('aria-expanded', String(menu.open));
      summary.setAttribute('aria-label', (menu.open ? summary.dataset.labelClose : summary.dataset.labelOpen)!);
      document.documentElement.style.overflow = menu.open ? 'hidden' : '';
    };
    sync();
    menu.addEventListener('toggle', sync);
    const close = () => {
      if (!menu.open) return;
      menu.open = false;
      sync();
    };
    // Anchor links (#index…) stay on the page: close the panel so the section is visible.
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        close();
        summary.focus();
      }
    });
    // Leaving mobile width with the panel open must not keep the page scroll-locked.
    matchMedia('(min-width: 861px)').addEventListener('change', (e) => e.matches && close());
    // Keep ?ref=… when switching language.
    menu.querySelectorAll<HTMLAnchorElement>('[data-keep-query]').forEach((a) =>
      a.addEventListener('click', () => {
        if (location.search || location.hash) a.href = a.pathname + location.search + location.hash;
      }),
    );
  }
</script>
