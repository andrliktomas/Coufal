</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  // Word cycler: every 2.6 s, flip in the next localized word.
  for (const el of document.querySelectorAll<HTMLElement>('[data-words]')) {
    const words: string[] = JSON.parse(el.dataset.words!);
    let i = 0;
    setInterval(() => {
      if (still.matches || document.hidden) return;
      i = (i + 1) % words.length;
      el.classList.remove('go');
      void el.offsetWidth;
      el.textContent = words[i];
      el.classList.add('go');
    }, 2600);
  }

  // Index: floating preview that follows the cursor.
  for (const box of document.querySelectorAll<HTMLElement>('[data-index]')) {
    const prev = box.querySelector<HTMLElement>('[data-preview]')!;
    const cards = new Map([...prev.querySelectorAll<HTMLElement>('.pv')].map((c) => [c.dataset.for!, c]));
    let shown: HTMLElement | undefined;
    box.addEventListener('pointermove', (e) => {
      const r = box.getBoundingClientRect();
      prev.style.left = `${e.clientX - r.left}px`;
      prev.style.top = `${e.clientY - r.top}px`;
    });
    for (const row of box.querySelectorAll<HTMLElement>('.idx')) {
      row.addEventListener('pointerenter', () => {
        shown?.classList.remove('on');
        shown = cards.get(row.dataset.id!);
        shown?.classList.add('on');
      });
    }
    box.addEventListener('pointerleave', () => shown?.classList.remove('on'));
  }
</script>
